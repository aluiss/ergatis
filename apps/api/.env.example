NODE_ENV=development
PORT=3333
DATABASE_URL=postgres://ergatis:ergatis@localhost:5432/ergatis
WEB_URL=http://localhost:3000
# URL pública da API. Como o Next encaminha /api, é a mesma URL do site.
API_URL=http://localhost:3000
BETTER_AUTH_SECRET=troque-por-um-valor-aleatorio-com-32-caracteres-ou-mais
# Proxies confiáveis à frente da API. O Next conta como 1; some o balanceador, se houver.
# A API não deve ficar exposta diretamente à internet.
TRUST_PROXY_HOPS=1

# E-mail. Sem SMTP_HOST, as mensagens são apenas registradas no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ergatis <nao-responda@exemplo.com>

# Cobrança: "fake" (desenvolvimento) ou "asaas".
BILLING_PROVIDER=fake
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
